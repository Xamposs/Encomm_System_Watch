{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ENCOMM SYSTEM WATCH",
  "version": "1.2.0",
  "identifier": "com.encomm.systemwatch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ENCOMM SYSTEM WATCH",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "maximizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#05070a"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}